$TTL    604800
@       IN      SOA     srv-dns-01.uv.interno. admin.uv.interno. (
                               1         ; Serial
                          604800         ; Refresh
                           86400         ; Retry
                         2419200         ; Expire
                          604800 )       ; Negative Cache TTL
;
@       IN      NS      srv-dns-01.uv.interno.

